# ---- Database ----
POSTGRES_USER=traffic_admin
POSTGRES_PASSWORD=change_me_in_local_env
POSTGRES_DB=traffic_management
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://traffic_admin:change_me_in_local_env@localhost:5432/traffic_management

# ---- Auth / JWT ----
JWT_SECRET_KEY=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- App ----
APP_ENV=development
APP_MODE=DEMO
# APP_MODE options: DEMO | AI | PRODUCTION
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000/api
VITE_WS_BASE_URL=ws://localhost:8000/ws
